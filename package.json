{
  "name": "DevHive-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts MainComposition out/video.mp4",
    "server": "tsx watch src/server/index.ts",
    "editor": "vite",
    "dev": "concurrently -n server,editor -c blue,green \"npm run server\" \"npm run editor\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.290",
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/player": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "cheerio": "1.0.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "msedge-tts": "^2.0.7",
    "nanoid": "5.0.7",
    "ollama": "0.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vite": "5.3.4"
  }
}
