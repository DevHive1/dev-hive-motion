# Ollama connection - point this at wherever Ollama is actually running.
# If Ollama runs on the same machine as this server, the default is fine.
# If Ollama runs elsewhere (e.g. a VPS while you develop from Termux), set
# OLLAMA_HOST to that machine's address.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Port for the Express API/agent server (the Vite editor proxies /api to this).
PORT=4000

# Stock media search (search_stock_images / search_stock_videos tools).
# Free - get a key instantly at https://www.pexels.com/api/ (no card needed).
# Without this set, those two tools will fail with a clear error; everything
# else still works.
PEXELS_API_KEY=

# web_search needs no key and nothing to configure - it uses DuckDuckGo's
# public HTML search, which is free with no signup.

# Rendering (the Export button / npm run render). Leave both blank on a
# normal Linux/Mac/Windows machine - Remotion downloads its own Chrome and
# this all works with zero config.
#
# On Termux/Android, Remotion's own bundled Chrome Headless Shell has no
# Android build ("Unsupported platform: android"). If you have a real
# Chromium installed (e.g. via termux-x11 - see README "Rendering directly
# on Termux" for the full setup), point this at it:
#   which chromium-browser
CHROME_EXECUTABLE_PATH=

# Set to "false" only if pure headless rendering doesn't work with your
# Chromium build and you need it to launch through an X11 display instead
# (termux-x11 running, DISPLAY=:0 exported in this same shell before
# `npm run dev`). Try headless (the default) first - it's simpler and
# doesn't need X11 running at all.
CHROME_HEADLESS=true

# How long (ms) a render is allowed to wait on things like fetching a
# remote video source to extract frames from. Remotion's own default is
# short (~30s) - too short for a slow mobile connection fetching a Pexels
# video. Raise this further if you still see delayRender()/timeout errors
# with a large default value already.
RENDER_TIMEOUT_MS=120000

# AI image generation (generate_ai_image) and voiceover narration
# (generate_voiceover), via Pollinations.ai. Image generation works at low
# volume without a key; voiceover generation often needs one even for a
# single request (it's backed by a paid third-party TTS provider behind
# the scenes). Get a free key at https://enter.pollinations.ai - without
# it, these two tools may be rate-limited or fail with a clear error;
# everything else still works.
POLLINATIONS_API_KEY=
